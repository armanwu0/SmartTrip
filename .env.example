# ==============================
# Smart Trip AI - Environment Variables
# Copy this file to .env and fill in your values.
# ==============================

# Django / deployment
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=

# Google Gemini AI (required)
GEMINI_API_KEY=your-gemini-api-key-here

# Google Maps / Places / Routes (required for real location data)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Frontend URLs
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:8000/api

# Example production values:
# SECRET_KEY=super-random-production-secret
# DEBUG=False
# ALLOWED_HOSTS=your-backend.onrender.com,your-backend.up.railway.app,localhost,127.0.0.1
# DATABASE_URL=postgres://user:password@host:5432/dbname
# CORS_ALLOWED_ORIGINS=https://your-project.vercel.app,https://your-project-git-main.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app,https://your-project-git-main.vercel.app
# FRONTEND_URL=https://your-project.vercel.app
# REACT_APP_API_URL=https://your-backend.onrender.com/api
